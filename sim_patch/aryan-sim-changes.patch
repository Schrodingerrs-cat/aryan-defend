@@ -579,7 +585,7 @@ class TelloDefendEnv(TerminalObservationMixin, DirectMARLEnv):
             raise ValueError(f"unknown reward_mode {mode!r}")
         self._closing_blackout = (self._closing_blackout - 1).clamp(min=0)
 
-        total = sum(terms.values())  # (E, D)
+        total = torch.nan_to_num(sum(terms.values()), nan=0.0, posinf=0.0, neginf=0.0)  # (E, D)
         for k, v in terms.items():
             if k not in self._ep_terms:
                 self._ep_terms[k] = torch.zeros(self.num_envs, device=self.device)
@@ -621,7 +627,24 @@ class TelloDefendEnv(TerminalObservationMixin, DirectMARLEnv):
         log["Curriculum/difficulty"] = torch.tensor(float(-1 if self.cfg.attacker_difficulty is None else self.cfg.attacker_difficulty))
         self.extras["log"] = log
 
+    def _blown_up(self) -> torch.Tensor:
+        """(E,) envs where a drone's state is non-finite or absurdly fast (a physics blow-up)."""
+        def_pos, def_vel = self._def_stack("root_pos_w"), self._def_stack("root_lin_vel_w")
+        att_pos, att_vel = self._attacker_states()
+        alive = self._attacker_alive
+        ok = torch.isfinite(def_pos).all(-1).all(-1) & torch.isfinite(def_vel).all(-1).all(-1)
+        ok &= (torch.isfinite(att_pos).all(-1) | ~alive).all(-1) & (torch.isfinite(att_vel).all(-1) | ~alive).all(-1)
+        fast = (def_vel.norm(dim=-1) > 15.0).any(-1) | ((att_vel.norm(dim=-1) > 15.0) & alive).any(-1)
+        bad = ~ok | fast
+        n = int(bad.sum())
+        if n:
+            self._blowups = getattr(self, "_blowups", 0) + n
+            if self._blowups <= 20 or self._blowups % 200 == 0:
+                print(f"[guard] reset {n} env(s) with a blown-up drone state (total {self._blowups})", flush=True)
+        return bad
+
     def _get_dones(self) -> tuple[dict[str, torch.Tensor], dict[str, torch.Tensor]]:
+        blown = self._blown_up()
         self._step_events()
         time_out = self.episode_length_buf >= self.max_episode_length - 1
         all_def_down = ~self._defender_alive.any(dim=-1)
@@ -634,6 +657,7 @@ class TelloDefendEnv(TerminalObservationMixin, DirectMARLEnv):
             done = self._breached | all_def_down
         else:
             done = self._breached | all_down | all_def_down
+        done = done | blown
         finished = done | time_out
         self._terminated = done
         self._finished = finished
